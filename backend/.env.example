# ─── Base de donnees ────────────────────────────────────────────
# PostgreSQL (TimescaleDB en production). Avec docker-compose fourni :
DATABASE_URL="postgresql://healthmesh:healthmesh@localhost:5432/healthmesh?schema=public"

# ─── Serveur ────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Origines autorisees pour le frontend (CORS), separees par des virgules. * = tout.
CORS_ORIGIN=*

# ─── Securite / JWT ─────────────────────────────────────────────
JWT_SECRET="change-me-in-production-please-32chars-min"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
OFFLINE_TOKEN_TTL=7d

# ─── Redis (optionnel) ──────────────────────────────────────────
# Si absent ou injoignable, un Pub/Sub en memoire prend le relais (mono-instance).
REDIS_URL="redis://localhost:6379"

# ─── IA TechY-Health ────────────────────────────────────────────
# Moteur de triage : "rules" (par defaut, hors-ligne) ou "llm".
IA_ENGINE=rules
# Si IA_ENGINE=llm, renseigner l'un des deux :
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-3-5-sonnet-latest

# ─── Simulateur de capteurs ─────────────────────────────────────
SIMULATOR_DEFAULT_INTERVAL_MS=2000
